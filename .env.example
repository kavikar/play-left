# Copy to .env and fill in locally. Never commit a real .env.
# Every value below is a placeholder — no real credentials, hosts, or payment data.

BASE_URL=https://brand-one.example.test

# Corporate TLS interception workaround. Leave unset unless you need it;
# it disables certificate verification for the whole Node process.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Generic credentials (fallbacks used when no brand-specific pair is set)
TEST_USERNAME=
TEST_PASSWORD=

# Brand-specific credentials, preferred over the generic pair above
BRAND_ONE_EMAIL=
BRAND_ONE_PASSWORD=

# Override the page auth:setup drives. Defaults to the brand-one test host.
LOGIN_URL=

# Guest checkout contact details — dummy values only
CHECKOUT_FIRST_NAME=test
CHECKOUT_LAST_NAME=user
CHECKOUT_EMAIL=test.user@example.test
CHECKOUT_MOBILE=0000000000

# Payment selection. Card numbers themselves live in test-data/payment-cards.local.json,
# which is git-ignored — this only picks which entry to use.
CHECKOUT_CARDHOLDER=test user
CHECKOUT_CARD_TYPE=visa
CHECKOUT_CARD_INDEX=0

# Bundled demo storefront (demo-app/). These are not secrets — the app prints
# them on its own sign-in page and authenticates nothing. They are read from
# the environment anyway so the shape matches every other brand.
DEMO_USERNAME=standard_user
DEMO_PASSWORD=demo_password

# Execution tuning (optional)
WORKERS=4
FULLY_PARALLEL=true
HEADED=false
